{
  "entities": {
    "Tournament": {
      "title": "Tournament",
      "description": "OFSAA Championship tournament state containing schedule, teams, venues, and real-time match results",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Championship tournament identifier",
          "maxLength": 100
        },
        "name": {
          "type": "string",
          "description": "Official championship name",
          "maxLength": 200
        },
        "classification": {
          "type": "string",
          "description": "School division classification",
          "maxLength": 20
        },
        "gender": {
          "type": "string",
          "description": "Gender classification",
          "maxLength": 30
        },
        "year": {
          "type": "number",
          "description": "Championship year"
        },
        "format": {
          "type": "string",
          "enum": ["20-team", "16-team"],
          "description": "Tournament format"
        },
        "dates": {
          "type": "string",
          "description": "Championship event dates",
          "maxLength": 120
        },
        "location": {
          "type": "string",
          "description": "Tournament host city",
          "maxLength": 120
        },
        "venues": {
          "type": "array",
          "description": "Available gym court locations"
        },
        "mainVenue": {
          "type": "string",
          "description": "Primary host venue school",
          "maxLength": 120
        },
        "teams": {
          "type": "array",
          "description": "List of participating teams and seeds"
        },
        "matches": {
          "type": "array",
          "description": "List of pool play and playoff matches"
        },
        "lastUpdated": {
          "type": "string",
          "description": "ISO string timestamp of last update",
          "maxLength": 64
        },
        "isSkeletonMode": {
          "type": "boolean",
          "description": "Whether initialized in skeleton state"
        }
      },
      "required": ["id", "name", "year", "teams", "matches"]
    },
    "Convenor": {
      "title": "Convenor",
      "description": "Authorized co-convenor or scorekeeper Google account granted tournament edit access",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "Lowercase verified Google account email address",
          "maxLength": 128
        },
        "label": {
          "type": "string",
          "description": "Optional role or gym assignment label",
          "maxLength": 80
        },
        "addedBy": {
          "type": "string",
          "format": "email",
          "description": "Primary convenor email who granted access",
          "maxLength": 128
        },
        "addedAt": {
          "type": "string",
          "description": "ISO timestamp when access was granted",
          "maxLength": 64
        }
      },
      "required": ["email", "addedBy", "addedAt"]
    }
  },
  "firestore": {
    "/tournaments/{tournamentId}": {
      "schema": "Tournament",
      "description": "Real-time championship tournament document read publicly by spectators and written exclusively by authorized convenors"
    },
    "/convenors/{convenorEmail}": {
      "schema": "Convenor",
      "description": "Private allowlist of authorized co-convenor Google accounts managed exclusively by the primary convenor"
    }
  }
}
