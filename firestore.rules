rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net default-deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Security & Validation Primitives
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidConvenorId(id) {
      return id is string &&
             id.size() >= 5 &&
             id.size() <= 128 &&
             id == id.lower() &&
             id.matches('^[a-z0-9._%+\\-]+@[a-z0-9.\\-]+\\.[a-z]{2,}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isPrimaryConvenor() {
      return isSignedIn() &&
             request.auth.token.email is string &&
             request.auth.token.email.lower() == 'brentnevills@gmail.com';
    }

    function isDelegatedConvenor() {
      return isSignedIn() &&
             request.auth.token.email is string &&
             exists(/databases/$(database)/documents/convenors/$(request.auth.token.email.lower()));
    }

    // Primary convenor OR any delegated co-convenor listed in /convenors/{email}
    function isConvenor() {
      return isPrimaryConvenor() || isDelegatedConvenor();
    }

    function isValidConvenorDoc(data, docId) {
      return data.keys().hasAll(['email', 'addedBy', 'addedAt']) &&
             data.keys().hasOnly(['email', 'label', 'addedBy', 'addedAt']) &&
             data.email is string &&
             data.email == docId &&
             data.email.size() <= 128 &&
             (!('label' in data) || (data.label is string && data.label.size() <= 80)) &&
             data.addedBy is string &&
             data.addedBy == request.auth.token.email.lower() &&
             data.addedBy.size() <= 128 &&
             data.addedAt is string &&
             data.addedAt.size() <= 64;
    }

    function isValidTournament(data) {
      return data.keys().hasAll(['id', 'name', 'year', 'teams', 'matches']) &&
             data.keys().hasOnly([
               'id',
               'name',
               'classification',
               'gender',
               'year',
               'format',
               'dates',
               'location',
               'venues',
               'mainVenue',
               'teams',
               'matches',
               'lastUpdated',
               'isSkeletonMode'
             ]) &&
             !('adminPasswordHash' in data) &&
             !('adminUsername' in data) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 100 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             (!('classification' in data) || (data.classification is string && data.classification.size() <= 20)) &&
             (!('gender' in data) || (data.gender is string && data.gender.size() <= 30)) &&
             (data.year is number || (data.year is string && data.year.size() <= 10)) &&
             (!('format' in data) || (data.format in ['20-team', '16-team'])) &&
             (!('dates' in data) || (data.dates is string && data.dates.size() <= 120)) &&
             (!('location' in data) || (data.location is string && data.location.size() <= 120)) &&
             (!('venues' in data) || (data.venues is list && data.venues.size() <= 20 && (data.venues.size() == 0 || (data.venues[0] is string && data.venues[0].size() <= 100)))) &&
             (!('mainVenue' in data) || (data.mainVenue is string && data.mainVenue.size() <= 120)) &&
             data.teams is list && data.teams.size() <= 50 &&
             (data.teams.size() == 0 || data.teams[0] is map) &&
             data.matches is list && data.matches.size() <= 150 &&
             (data.matches.size() == 0 || data.matches[0] is map) &&
             (!('lastUpdated' in data) || (data.lastUpdated is string && data.lastUpdated.size() <= 64)) &&
             (!('isSkeletonMode' in data) || data.isSkeletonMode is bool);
    }

    // Connection validation path
    match /test/connection {
      allow get: if true;
    }

    // Private co-convenor allowlist (managed strictly by primary convenor; PII protected)
    match /convenors/{convenorEmail} {
      allow get: if isValidConvenorId(convenorEmail) &&
                    isSignedIn() &&
                    (isPrimaryConvenor() ||
                     (request.auth.token.email is string &&
                      request.auth.token.email.lower() == convenorEmail));
      allow list: if isPrimaryConvenor() && resource.data.addedBy == 'brentnevills@gmail.com';
      allow create: if isPrimaryConvenor() &&
                       isValidConvenorId(convenorEmail) &&
                       isValidConvenorDoc(incoming(), convenorEmail);
      allow update: if isPrimaryConvenor() &&
                       isValidConvenorId(convenorEmail) &&
                       isValidConvenorDoc(incoming(), convenorEmail) &&
                       incoming().email == existing().email &&
                       incoming().addedBy == existing().addedBy &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['label', 'addedAt']);
      allow delete: if isPrimaryConvenor() && isValidConvenorId(convenorEmail);
    }

    // Real-time tournament state: public read for spectator devices, convenor-only authenticated writes
    match /tournaments/{tournamentId} {
      allow get: if isValidId(tournamentId);
      allow list: if false;
      allow create: if isSignedIn() &&
                       isValidId(tournamentId) &&
                       isValidTournament(incoming()) &&
                       isConvenor();
      allow update: if isSignedIn() &&
                       isValidId(tournamentId) &&
                       isValidTournament(incoming()) &&
                       incoming().id == existing().id &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'name',
                         'classification',
                         'gender',
                         'year',
                         'format',
                         'dates',
                         'location',
                         'venues',
                         'mainVenue',
                         'teams',
                         'matches',
                         'lastUpdated',
                         'isSkeletonMode'
                       ]) &&
                       isConvenor();
      allow delete: if false;
    }
  }
}
