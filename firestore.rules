rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net default-deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Security & Validation Primitives
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidTournament(data) {
      return data.keys().hasAll(['id', 'name', 'year', 'teams', 'matches']) &&
             data.id is string && data.id.size() <= 100 &&
             data.name is string && data.name.size() <= 200 &&
             data.year is number &&
             data.teams is list && data.teams.size() <= 50 &&
             data.matches is list && data.matches.size() <= 120;
    }

    // Connection validation path
    match /test/connection {
      allow read: if true;
    }

    // Real-time tournament state for players, coaches, parents, and convenors
    match /tournaments/{tournamentId} {
      allow get: if isValidId(tournamentId);
      allow list: if true;
      allow create, update: if isValidId(tournamentId) && isValidTournament(incoming());
      allow delete: if false;
    }
  }
}
